cabal-version: 3.0
name: stage0-consumer
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Downstream
  hs-source-dirs: src
  cpp-options: -DSTAGE0_DOWNSTREAM
  build-depends: base >= 4.20 && < 4.21, stage0-upstream
  default-language: Haskell2010

executable stage0-consumer
  main-is: Main.hs
  hs-source-dirs: app shared
  other-modules: Component
  cpp-options: -DEXECUTABLE_CONTEXT
  build-depends: base >= 4.20 && < 4.21
  default-language: Haskell2010

test-suite stage0-consumer-test
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test shared
  other-modules: Component
  cpp-options: -DTEST_CONTEXT
  build-depends: base >= 4.20 && < 4.21
  default-language: Haskell2010
