cabal-version: 3.0
name: project-variants
version: 0.1.0.0
build-type: Simple

flag alternate
  default: False
  manual: True

library
  hs-source-dirs: src
  exposed-modules: Variants
  other-modules: Selected, Generated
  if flag(alternate)
    hs-source-dirs: alternate
  else
    hs-source-dirs: standard
  build-depends: base >= 4.20 && < 4.21
  default-language: Haskell2010

library details
  hs-source-dirs: internal
  exposed-modules: Details
  build-depends: base >= 4.20 && < 4.21
  default-language: Haskell2010

executable project-variants
  main-is: Main.hs
  hs-source-dirs: app
  build-depends: base >= 4.20 && < 4.21, project-variants, project-variants:details
  default-language: Haskell2010

test-suite checks
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends: base >= 4.20 && < 4.21, project-variants:details
  default-language: Haskell2010

benchmark bench
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: bench
  build-depends: base >= 4.20 && < 4.21
  default-language: Haskell2010
