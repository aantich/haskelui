{
  "name": "JavaScript",
  "scopeName": "source.js",
  "fileTypes": ["js", "mjs", "cjs", "jsx"],
  "patterns": [
    { "name": "comment.line.double-slash.js", "match": "//.*$" },
    { "name": "comment.block.js", "begin": "/\\*", "end": "\\*/" },
    { "name": "string.quoted.double.js", "match": "\"(?:\\\\.|[^\"\\\\])*\"" },
    { "name": "string.quoted.single.js", "match": "'(?:\\\\.|[^'\\\\])*'" },
    { "name": "string.template.js", "begin": "`", "end": "`", "patterns": [{ "name": "constant.character.escape.js", "match": "\\\\." }] },
    { "name": "keyword.control.js", "match": "\\b(?:await|break|case|catch|class|const|continue|debugger|default|delete|do|else|export|extends|finally|for|from|function|if|import|in|instanceof|let|new|of|return|static|super|switch|throw|try|typeof|var|void|while|with|yield)\\b" },
    { "name": "constant.language.js", "match": "\\b(?:true|false|null|undefined|NaN|Infinity)\\b" },
    { "name": "constant.numeric.js", "match": "\\b(?:0[xX][0-9A-Fa-f]+|0[bB][01]+|0[oO][0-7]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)\\b" },
    { "name": "entity.name.function.js", "match": "\\b[A-Za-z_$][A-Za-z0-9_$]*(?=\\s*\\()" }
  ]
}

